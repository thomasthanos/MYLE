{
  "name": "make-your-life-easier",
  "private": true,
  "version": "10.1.0",
  "type": "module",
  "myle": {
    "extensionUrl": "https://chromewebstore.google.com/detail/mifjffbnaeeljjfboiglbcoaokgdilca"
  },
  "scripts": {
    "tauri": "tauri",
    "dev": "tauri dev",
    "web:mobile": "vite build --mode mobile",
    "build": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/build-setup.ps1",
    "check": "node scripts/check-site.mjs && svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json",
    "test": "cargo test --manifest-path backend/Cargo.toml --locked --workspace && node --test \"scripts/tests/*.test.mjs\"",
    "lint": "cargo clippy --manifest-path backend/Cargo.toml --locked --workspace --all-targets -- -D warnings"
  },
  "dependencies": {
    "@fontsource/comic-neue": "^5.3.0",
    "@fontsource/kalam": "^5.3.0",
    "@fontsource/permanent-marker": "^5.3.0",
    "@lucide/svelte": "^1.47.0",
    "@tauri-apps/api": "~2.11.1",
    "@tauri-apps/plugin-barcode-scanner": "~2.4.6",
    "@tauri-apps/plugin-opener": "^2.5.5"
  },
  "devDependencies": {
    "@simplewebauthn/server": "13.3.2",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tauri-apps/cli": "^2.11.5",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^24.0.0",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "typescript": "~6.0.3",
    "vite": "^8.3.0"
  }
}
