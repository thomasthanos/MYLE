{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "links",
  "description": "Web links open in the browser, from the main window only (the splash and the notice open none)",
  "windows": ["main"],
  "permissions": [
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "https://*" }, { "url": "http://*" }]
    }
  ]
}
