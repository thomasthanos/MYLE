{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MYLE",
  "mainBinaryName": "MYLE",
  "version": "../package.json",
  "identifier": "com.thomasthanos.makeyourlifeeasier",
  "build": {
    "beforeDevCommand": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/bootstrap-game-saves.ps1 && node scripts/prepare-extension.mjs && npx vite",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/bootstrap-game-saves.ps1 && node scripts/prepare-extension.mjs && npx vite build",
    "frontendDist": "target/web"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-src 'none'",
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": {
    "active": false,
    "publisher": "ThomasThanos",
    "copyright": "© 2026 ThomasThanos",
    "category": "Utility",
    "shortDescription": "MYLE — Make Your Life Easier",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "resources": {
      "resources/ludusavi/ludusavi.exe": "ludusavi/ludusavi.exe",
      "resources/ludusavi/manifest.yaml": "ludusavi/manifest.yaml",
      "resources/ludusavi/LICENSE": "ludusavi/LICENSE",
      "resources/ludusavi/THIRD-PARTY-NOTICES.txt": "ludusavi/THIRD-PARTY-NOTICES.txt",
      "resources/spicetify/placeholder-theme/color.ini": "spicetify/placeholder-theme/color.ini",
      "resources/spicetify/placeholder-theme/user.css": "spicetify/placeholder-theme/user.css",
      "resources/spicetify/MIT-NOTICE.txt": "spicetify/MIT-NOTICE.txt",
      "../extension/manifest.json": "extension/manifest.json",
      "../extension/psl.js": "extension/psl.js",
      "../extension/background.js": "extension/background.js",
      "../extension/content.js": "extension/content.js",
      "../extension/passkeys.js": "extension/passkeys.js",
      "../extension/popup.html": "extension/popup.html",
      "../extension/popup.css": "extension/popup.css",
      "../extension/popup.js": "extension/popup.js",
      "../extension/icons/32.png": "extension/icons/32.png",
      "../extension/icons/128.png": "extension/icons/128.png",
      "../extension/firefox/manifest.json": "extension/firefox/manifest.json",
      "../extension/firefox/psl.js": "extension/firefox/psl.js",
      "../extension/firefox/background.js": "extension/firefox/background.js",
      "../extension/firefox/content.js": "extension/firefox/content.js",
      "../extension/firefox/passkeys.js": "extension/firefox/passkeys.js",
      "../extension/firefox/popup.html": "extension/firefox/popup.html",
      "../extension/firefox/popup.css": "extension/firefox/popup.css",
      "../extension/firefox/popup.js": "extension/firefox/popup.js",
      "../extension/firefox/icons/32.png": "extension/firefox/icons/32.png",
      "../extension/firefox/icons/128.png": "extension/firefox/icons/128.png"
    }
  }
}
